# Temporary PDF inspection renderings (30+ page checks)
pdf_page_inspection/

# IDE & Editor artifacts
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Web server logs & temporary uploads
*.log
uploads/temp/
